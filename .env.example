# Supabase project URL. Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Post images use this same URL and anon key, with the private post-media
# bucket from supabase/migrations/20260930183000_post_media.sql.
# No extra environment variable is required. Do not add the service role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Grok Bot webhook that researches a brand from links. Server-only.
# Do not prefix these with NEXT_PUBLIC_. Leave them unset until an admin
# copies them from the Grok Bot desktop app: open the routine, and copy
# "POST to" plus the sender key (not the whole header).
#
# This app sends the key as:
#   Authorization: Bearer <BRAND_BOT_WEBHOOK_SECRET>
# A 2xx response means the bot started a run. It does not mean the brand
# notes are written yet. The bot writes clients.brand itself.
BRAND_BOT_WEBHOOK_URL=
BRAND_BOT_WEBHOOK_SECRET=

# DOT art jobs. Server-only. Do not prefix these with NEXT_PUBLIC_.
# This app does not call OpenAI or any image model. DOT draws the images.
#
# Production Slack channel: #content in agents-wby7363.slack.com.
# Channel id: C0C5S889VTL
# If DOT_SLACK_BOT_TOKEN is set and DOT_SLACK_CHANNEL_ID is blank, the app
# still posts to C0C5S889VTL. Leave the token blank until the bot is invited
# to #content. The job is still queued, and DOT can pull it from the plugin.
DOT_SLACK_CHANNEL_ID=C0C5S889VTL
DOT_SLACK_BOT_TOKEN=

# Bearer secret for ChatGPT / DOT callbacks to /api/dot/art-jobs/*.
# Required on Vercel Production for those routes. Paste the secret only.
DOT_ART_CALLBACK_SECRET=

# Service role key from Supabase → Project Settings → API.
# Server-only. Used only by the DOT callback routes to write the private
# post-media bucket. Studio pages do not use it. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
