# Supabase project URL. Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Post images use this same URL and anon key, with the private post-media
# bucket from supabase/migrations/20260930183000_post_media.sql.
# No extra environment variable is required. Do not add the service role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Grok Bot webhook that researches a brand from links. Server-only.
# Do not prefix these with NEXT_PUBLIC_. Leave them unset until an admin
# copies them from the Grok Bot desktop app: open the routine, and copy
# "POST to" plus the sender key (not the whole header).
#
# This app sends the key as:
#   Authorization: Bearer <BRAND_BOT_WEBHOOK_SECRET>
# A 2xx response means the bot started a run. It does not mean the brand
# notes are written yet. The bot writes clients.brand itself.
BRAND_BOT_WEBHOOK_URL=
BRAND_BOT_WEBHOOK_SECRET=
